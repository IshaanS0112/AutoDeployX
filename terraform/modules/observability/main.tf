# Alarms and a dashboard over metrics AWS already publishes for free.

resource "aws_sns_topic" "alerts" {
  name = "${var.name_prefix}-alerts"

  # The AWS-managed key, not a customer-managed one.
  kms_master_key_id = "alias/aws/sns"

  tags = var.tags
}

resource "aws_sns_topic_subscription" "email" {
  topic_arn = aws_sns_topic.alerts.arn
  protocol  = "email"
  endpoint  = var.alert_email
  # NOTE: AWS sends a confirmation email. Until it is clicked the subscription
  # is PendingConfirmation and NO alarm will ever reach you.
}

resource "aws_cloudwatch_metric_alarm" "alb_5xx" {
  alarm_name        = "${var.name_prefix}-alb-5xx"
  alarm_description = "ALB is returning 5xx responses generated by the load balancer itself (no healthy target, or target connection failures)."

  namespace   = "AWS/ApplicationELB"
  metric_name = "HTTPCode_ELB_5XX_Count"
  statistic   = "Sum"
  period      = 60

  comparison_operator = "GreaterThanThreshold"
  threshold           = 5
  evaluation_periods  = 2 # two consecutive minutes, so a single blip does not page

  dimensions = { LoadBalancer = var.alb_arn_suffix }

  # Critical: without this, a period with no requests evaluates as
  # INSUFFICIENT_DATA rather than OK. "No traffic" is not "broken".
  treat_missing_data = "notBreaching"

  alarm_actions = [aws_sns_topic.alerts.arn]
  ok_actions    = [aws_sns_topic.alerts.arn]
  tags          = var.tags
}

resource "aws_cloudwatch_metric_alarm" "target_5xx" {
  for_each = var.services

  alarm_name        = "${var.name_prefix}-${each.key}-target-5xx"
  alarm_description = "The ${each.key} application itself is returning 5xx. Distinct from the ELB 5xx alarm: this one means the app answered and the answer was an error."

  namespace   = "AWS/ApplicationELB"
  metric_name = "HTTPCode_Target_5XX_Count"
  statistic   = "Sum"
  period      = 60

  comparison_operator = "GreaterThanThreshold"
  threshold           = 5
  evaluation_periods  = 2

  dimensions = {
    LoadBalancer = var.alb_arn_suffix
    TargetGroup  = each.value.target_group_arn_suffix
  }

  treat_missing_data = "notBreaching"
  alarm_actions      = [aws_sns_topic.alerts.arn]
  tags               = merge(var.tags, { Service = each.key })
}

resource "aws_cloudwatch_metric_alarm" "target_latency_p95" {
  for_each = var.services

  alarm_name        = "${var.name_prefix}-${each.key}-latency-p95"
  alarm_description = "p95 response time for ${each.key} above ${var.latency_p95_threshold_seconds}s."

  namespace   = "AWS/ApplicationELB"
  metric_name = "TargetResponseTime"
  # p95, not Average. An average hides the tail: a service where 1 request in
  # 20 takes eight seconds has a fine average and a bad experience.
  extended_statistic = "p95"
  period             = 300

  comparison_operator = "GreaterThanThreshold"
  threshold           = var.latency_p95_threshold_seconds
  evaluation_periods  = 2

  dimensions = {
    LoadBalancer = var.alb_arn_suffix
    TargetGroup  = each.value.target_group_arn_suffix
  }

  treat_missing_data = "notBreaching"
  alarm_actions      = [aws_sns_topic.alerts.arn]
  tags               = merge(var.tags, { Service = each.key })
}

resource "aws_cloudwatch_metric_alarm" "unhealthy_hosts" {
  for_each = var.services

  alarm_name        = "${var.name_prefix}-${each.key}-unhealthy-targets"
  alarm_description = "${each.key} has targets failing ALB health checks. During a deploy this is what the circuit breaker is reacting to; outside one it means a running task has gone bad."

  namespace           = "AWS/ApplicationELB"
  metric_name         = "UnHealthyHostCount"
  statistic           = "Maximum"
  period              = 60
  comparison_operator = "GreaterThanThreshold"
  threshold           = 0
  evaluation_periods  = 3 # tolerate the normal unhealthy window during a rollout

  dimensions = {
    LoadBalancer = var.alb_arn_suffix
    TargetGroup  = each.value.target_group_arn_suffix
  }

  treat_missing_data = "notBreaching"
  alarm_actions      = [aws_sns_topic.alerts.arn]
  tags               = merge(var.tags, { Service = each.key })
}

resource "aws_cloudwatch_metric_alarm" "service_running_count" {
  for_each = var.services

  alarm_name        = "${var.name_prefix}-${each.key}-no-running-tasks"
  alarm_description = "${each.key} has fewer running tasks than desired. On FARGATE_SPOT this can be a reclaim; sustained, it is a crash loop."

  namespace   = "ECS/ContainerInsights"
  metric_name = "RunningTaskCount"
  statistic   = "Minimum"
  period      = 60

  comparison_operator = "LessThanThreshold"
  threshold           = 1
  evaluation_periods  = 3

  dimensions = {
    ClusterName = var.cluster_name
    ServiceName = each.value.service_name
  }

  # This metric only exists when Container Insights is on.
  treat_missing_data = "missing"
  alarm_actions      = [aws_sns_topic.alerts.arn]
  tags               = merge(var.tags, { Service = each.key })
}

resource "aws_cloudwatch_metric_alarm" "rds_cpu" {
  alarm_name        = "${var.name_prefix}-rds-cpu"
  alarm_description = "Database CPU sustained above 80%. On a t3.micro this also burns CPU credits, which is the failure that arrives an hour later as everything being slow."

  namespace   = "AWS/RDS"
  metric_name = "CPUUtilization"
  statistic   = "Average"
  period      = 300

  comparison_operator = "GreaterThanThreshold"
  threshold           = 80
  evaluation_periods  = 2

  dimensions = { DBInstanceIdentifier = var.rds_identifier }

  treat_missing_data = "notBreaching"
  alarm_actions      = [aws_sns_topic.alerts.arn]
  tags               = var.tags
}

resource "aws_cloudwatch_metric_alarm" "rds_storage" {
  alarm_name        = "${var.name_prefix}-rds-free-storage"
  alarm_description = "Less than 2GB free on the database volume."

  namespace   = "AWS/RDS"
  metric_name = "FreeStorageSpace"
  statistic   = "Minimum"
  period      = 300

  comparison_operator = "LessThanThreshold"
  threshold           = 2147483648 # 2 GiB in bytes
  evaluation_periods  = 1

  dimensions = { DBInstanceIdentifier = var.rds_identifier }

  treat_missing_data = "notBreaching"
  alarm_actions      = [aws_sns_topic.alerts.arn]
  tags               = var.tags
}

# --- Dashboard -------------------------------------------------------------
# Three free dashboards per account; this uses one.

resource "aws_cloudwatch_dashboard" "this" {
  dashboard_name = "${var.name_prefix}-overview"

  dashboard_body = jsonencode({
    widgets = concat(
      [
        {
          type = "text", x = 0, y = 0, width = 24, height = 2
          properties = {
            markdown = "# ${var.name_prefix} — production\nALB `${var.alb_dns_name}` · region `${var.aws_region}`\n\nRequest rate, error rate and latency per service, plus database health. Metrics are the free ALB/RDS set; no custom metrics are published."
          }
        },
        {
          type = "metric", x = 0, y = 2, width = 12, height = 6
          properties = {
            title  = "Request rate (per minute)"
            region = var.aws_region
            view   = "timeSeries"
            stat   = "Sum"
            period = 60
            metrics = [
              for k, v in var.services :
              ["AWS/ApplicationELB", "RequestCount", "TargetGroup", v.target_group_arn_suffix, "LoadBalancer", var.alb_arn_suffix, { label = k }]
            ]
          }
        },
        {
          type = "metric", x = 12, y = 2, width = 12, height = 6
          properties = {
            title  = "Response time p50 / p95 / p99"
            region = var.aws_region
            view   = "timeSeries"
            period = 60
            yAxis  = { left = { label = "seconds", showUnits = false } }
            metrics = flatten([
              for k, v in var.services : [
                ["AWS/ApplicationELB", "TargetResponseTime", "TargetGroup", v.target_group_arn_suffix, "LoadBalancer", var.alb_arn_suffix, { label = "${k} p50", stat = "p50" }],
                ["...", { label = "${k} p95", stat = "p95" }],
                ["...", { label = "${k} p99", stat = "p99" }],
              ]
            ])
          }
        },
        {
          type = "metric", x = 0, y = 8, width = 12, height = 6
          properties = {
            title  = "Errors — ELB 5xx vs target 5xx vs 4xx"
            region = var.aws_region
            view   = "timeSeries"
            stat   = "Sum"
            period = 60
            metrics = flatten([
              [["AWS/ApplicationELB", "HTTPCode_ELB_5XX_Count", "LoadBalancer", var.alb_arn_suffix, { label = "ELB 5xx (no healthy target)" }]],
              [
                for k, v in var.services :
                ["AWS/ApplicationELB", "HTTPCode_Target_5XX_Count", "TargetGroup", v.target_group_arn_suffix, "LoadBalancer", var.alb_arn_suffix, { label = "${k} app 5xx" }]
              ],
              [
                for k, v in var.services :
                ["AWS/ApplicationELB", "HTTPCode_Target_4XX_Count", "TargetGroup", v.target_group_arn_suffix, "LoadBalancer", var.alb_arn_suffix, { label = "${k} 4xx" }]
              ],
            ])
          }
        },
        {
          type = "metric", x = 12, y = 8, width = 12, height = 6
          properties = {
            title  = "Healthy vs unhealthy targets — watch this during a deploy"
            region = var.aws_region
            view   = "timeSeries"
            stat   = "Maximum"
            period = 60
            metrics = flatten([
              for k, v in var.services : [
                ["AWS/ApplicationELB", "HealthyHostCount", "TargetGroup", v.target_group_arn_suffix, "LoadBalancer", var.alb_arn_suffix, { label = "${k} healthy" }],
                ["AWS/ApplicationELB", "UnHealthyHostCount", "TargetGroup", v.target_group_arn_suffix, "LoadBalancer", var.alb_arn_suffix, { label = "${k} unhealthy" }],
              ]
            ])
          }
        },
        {
          type = "metric", x = 0, y = 14, width = 12, height = 6
          properties = {
            title  = "RDS — CPU, connections, free storage"
            region = var.aws_region
            view   = "timeSeries"
            period = 300
            metrics = [
              ["AWS/RDS", "CPUUtilization", "DBInstanceIdentifier", var.rds_identifier, { label = "CPU %", stat = "Average" }],
              ["AWS/RDS", "DatabaseConnections", "DBInstanceIdentifier", var.rds_identifier, { label = "connections", stat = "Maximum" }],
              ["AWS/RDS", "FreeStorageSpace", "DBInstanceIdentifier", var.rds_identifier, { label = "free bytes", stat = "Minimum", yAxis = "right" }],
            ]
          }
        },
        {
          type = "metric", x = 12, y = 14, width = 12, height = 6
          properties = {
            title  = "CPU credit balance (t3.micro burstable)"
            region = var.aws_region
            view   = "timeSeries"
            stat   = "Minimum"
            period = 300
            metrics = [
              ["AWS/RDS", "CPUCreditBalance", "DBInstanceIdentifier", var.rds_identifier, { label = "credits" }],
            ]
            annotations = {
              horizontal = [{ label = "credit exhaustion — everything gets slow here", value = 10 }]
            }
          }
        },
      ],
      [
        for idx, k in sort(keys(var.services)) : {
          type = "log", x = 0, y = 20 + (idx * 6), width = 24, height = 6
          properties = {
            title  = "${k} — recent 5xx and errors"
            region = var.aws_region
            view   = "table"
            query  = "SOURCE '/ecs/${var.name_prefix}/${k}' | fields @timestamp, @message | filter @message like /(?i)(error|exception|traceback|\" 5\\d\\d )/ | sort @timestamp desc | limit 50"
          }
        }
      ],
    )
  })
}

# SLO error-budget burn rate.

locals {
  # 99% SLO -> 0.01 error budget. The burn rate is the observed error ratio
  # divided by this, so "1.0" means exactly on budget.
  error_budget = 1 - var.availability_slo

  burn_windows = {
    fast = { period = 3600, rate = var.slo_burn_rate_fast, evaluation_periods = 1 }
    slow = { period = 21600, rate = var.slo_burn_rate_slow, evaluation_periods = 1 }
  }

  burn_alarms = var.enable_slo_alarms ? {
    for pair in setproduct(keys(var.services), keys(local.burn_windows)) :
    "${pair[0]}-${pair[1]}" => {
      service = pair[0]
      window  = pair[1]
    }
  } : {}
}

resource "aws_cloudwatch_metric_alarm" "slo_burn" {
  for_each = local.burn_alarms

  alarm_name = "${var.name_prefix}-${each.value.service}-slo-burn-${each.value.window}"
  alarm_description = join(" ", [
    "${each.value.service} is consuming its error budget at more than",
    "${local.burn_windows[each.value.window].rate}x over",
    "${local.burn_windows[each.value.window].period / 3600}h.",
    "SLO is ${var.availability_slo * 100}% availability, so the budget is",
    "${local.error_budget * 100}% of requests.",
  ])

  comparison_operator = "GreaterThanThreshold"
  threshold           = local.burn_windows[each.value.window].rate
  evaluation_periods  = local.burn_windows[each.value.window].evaluation_periods

  # No traffic means no budget burned.
  treat_missing_data = "notBreaching"

  metric_query {
    id          = "burn"
    label       = "${each.value.service} error-budget burn rate"
    expression  = "IF(requests > 0, (errors / requests) / ${local.error_budget}, 0)"
    return_data = true
  }

  metric_query {
    id = "requests"
    metric {
      namespace   = "AWS/ApplicationELB"
      metric_name = "RequestCount"
      stat        = "Sum"
      period      = local.burn_windows[each.value.window].period
      dimensions = {
        LoadBalancer = var.alb_arn_suffix
        TargetGroup  = var.services[each.value.service].target_group_arn_suffix
      }
    }
  }

  metric_query {
    id = "errors"
    metric {
      namespace = "AWS/ApplicationELB"
      # Target 5xx, not ELB 5xx: this measures the application's own failures.
      # ELB-generated 5xx is a different fault with a different response.
      metric_name = "HTTPCode_Target_5XX_Count"
      stat        = "Sum"
      period      = local.burn_windows[each.value.window].period
      dimensions = {
        LoadBalancer = var.alb_arn_suffix
        TargetGroup  = var.services[each.value.service].target_group_arn_suffix
      }
    }
  }

  alarm_actions = [aws_sns_topic.alerts.arn]
  tags = merge(var.tags, {
    Service = each.value.service
    Window  = each.value.window
  })
}

# Saved CloudWatch Logs Insights queries.

locals {
  service_log_groups = [for key in keys(var.services) : "/ecs/${var.name_prefix}/${key}"]
}

resource "aws_cloudwatch_query_definition" "slowest_requests" {
  name            = "${var.name_prefix}/01-slowest-requests"
  log_group_names = local.service_log_groups

  query_string = <<-QUERY
    fields @timestamp, correlation_id, method, path, status, request_time, upstream_time
    | filter ispresent(request_time)
    | sort request_time desc
    | limit 50
  QUERY
}

resource "aws_cloudwatch_query_definition" "p95_latency_by_path" {
  name            = "${var.name_prefix}/02-latency-percentiles-by-path"
  log_group_names = local.service_log_groups

  # Where the time actually goes. A p95 on the whole service is one number; a
  # p95 per path tells you which endpoint to look at.
  query_string = <<-QUERY
    fields path, request_time
    | filter ispresent(request_time)
    | stats count(*) as requests,
            avg(request_time) as avg,
            pct(request_time, 50) as p50,
            pct(request_time, 95) as p95,
            pct(request_time, 99) as p99
            by path
    | sort p95 desc
    | limit 25
  QUERY
}

resource "aws_cloudwatch_query_definition" "errors_with_correlation_id" {
  name            = "${var.name_prefix}/03-errors-with-correlation-id"
  log_group_names = local.service_log_groups

  query_string = <<-QUERY
    fields @timestamp, correlation_id, method, path, status, upstream_status, request_time
    | filter status >= 500
    | sort @timestamp desc
    | limit 100
  QUERY
}

resource "aws_cloudwatch_query_definition" "trace_one_request" {
  name            = "${var.name_prefix}/04-trace-one-request"
  log_group_names = local.service_log_groups

  # The payoff of the correlation id. Paste an X-Request-ID from a bug report
  # and get every line both containers wrote for it, in order.
  query_string = <<-QUERY
    fields @timestamp, @logStream, @message
    | filter @message like /PASTE_CORRELATION_ID_HERE/
    | sort @timestamp asc
    | limit 200
  QUERY
}

resource "aws_cloudwatch_query_definition" "availability_slo" {
  name            = "${var.name_prefix}/05-availability-against-slo"
  log_group_names = local.service_log_groups

  # The same number the burn-rate alarms compute from ALB metrics, derived
  # independently from the access log.
  query_string = <<-QUERY
    fields status
    | filter ispresent(status)
    | stats count(*) as total,
            sum(status >= 500) as errors,
            (1 - (sum(status >= 500) / count(*))) * 100 as availability_pct
  QUERY
}

resource "aws_cloudwatch_query_definition" "connection_pool_exhaustion" {
  name            = "${var.name_prefix}/06-database-connection-errors"
  log_group_names = local.service_log_groups

  # The specific failure the manifest's connection budget exists to prevent.
  query_string = <<-QUERY
    fields @timestamp, @logStream, @message
    | filter @message like /remaining connection slots|QueuePool limit|too many clients|OperationalError/
    | sort @timestamp desc
    | limit 100
  QUERY
}

resource "aws_cloudwatch_query_definition" "rate_limited" {
  name            = "${var.name_prefix}/07-rate-limited-clients"
  log_group_names = local.service_log_groups

  query_string = <<-QUERY
    fields remote_addr, path
    | filter status = 429
    | stats count(*) as shed by remote_addr
    | sort shed desc
    | limit 25
  QUERY
}

resource "aws_cloudwatch_query_definition" "deploy_window" {
  name            = "${var.name_prefix}/08-what-happened-during-the-deploy"
  log_group_names = local.service_log_groups

  # Run this with the time range set to the deploy window.
  query_string = <<-QUERY
    fields @timestamp, @logStream, status, path, request_time
    | filter status >= 400
    | stats count(*) as errors by bin(1m), status
    | sort @timestamp asc
  QUERY
}
