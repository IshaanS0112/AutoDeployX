 @app.get("/health", tags=["meta"])
-def health() -> dict[str, str]:
-    return {"status": "ok"}
+def health(response: Response) -> dict[str, object]:
+    """Is this instance able to serve requests? Used by the load balancer.
+
+    Checks the database, because a service that cannot reach its database
+    cannot answer a single useful request. `return {"status": "ok"}` would pass
+    while every real endpoint 500s — which means a deploy that broke the
+    connection string would sail through its health check and take production
+    down looking green.
+
+    Returns 503 when unhealthy so the ALB deregisters this target, and so the
+    ECS deployment circuit breaker sees a failing rollout and rolls back.
+
+    The tradeoff, stated plainly: with one running task, a database blip longer
+    than the unhealthy threshold (3 x 15s) takes the whole service out of the
+    load balancer rather than serving the frontend with a broken API. That is
+    the correct behaviour for a deployment gate and the wrong behaviour for
+    availability; the fix is more than one task, not a shallower check.
+    """
+    checks: dict[str, str] = {}
+    healthy = True
+
+    try:
+        with engine.connect() as conn:
+            conn.execute(text("SELECT 1"))
+        checks["database"] = "ok"
+    except Exception as exc:  # noqa: BLE001 - any failure here means unhealthy
+        # Logged at warning, not error: during a rolling deploy this fires
+        # briefly and legitimately while the new task starts.
+        logger.warning("health check: database unreachable: %s", exc)
+        checks["database"] = "unreachable"
+        healthy = False
+
+    if not healthy:
+        response.status_code = status.HTTP_503_SERVICE_UNAVAILABLE
+
+    return {
+        "status": "healthy" if healthy else "unhealthy",
+        "checks": checks,
+        # Injected by the pipeline at image build time. This is what lets you
+        # read off a live URL exactly which commit is serving traffic, and what
+        # scripts/smoke-test.sh asserts against after a deploy.
+        "commit": os.getenv("GIT_SHA", "unknown"),
+        "service": os.getenv("SERVICE_NAME", "finsight"),
+    }
 
 
