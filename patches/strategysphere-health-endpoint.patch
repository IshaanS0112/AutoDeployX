+def liveness() -> dict[str, str]:
+    """Is the process running and able to answer?
+
+    Deliberately shallow: it touches nothing external. This is what the
+    container health check uses, because the question it answers is "should
+    this container be restarted", and restarting a container will not fix a
+    database that is down.
+    """
